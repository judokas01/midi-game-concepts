[node name="Center" type="CenterContainer" parent="Hud/Overlay"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Box" type="VBoxContainer" parent="Hud/Overlay/Center"]
custom_minimum_size = Vector2(680, 0)
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 10

[node name="Heading" type="Label" parent="Hud/Overlay/Center/Box"]
layout_mode = 2
theme_override_fonts/font = SubResource("SystemFont_bold")
theme_override_font_sizes/font_size = 30
text = "King Gong"
horizontal_alignment = 1

[node name="Body" type="RichTextLabel" parent="Hud/Overlay/Center/Box"]
layout_mode = 2
mouse_filter = 2
bbcode_enabled = true
text = "[center]Swing the gorilla through the treetops. The five long bushes are the staff lines; every branch sits on a note. Play that note to grab the branch.

[b]Hold the note as long as the branch is thick[/b]: thin = 1 beat, thick = 2 beats. Let go too early and you drop, hang on too long and the branch breaks. A liana below a gap is a rest: let go on time and bounce off it.

A wrong note is a fall too. Magic bananas bounce you back up. You start with 3, and more hang from some branches.

There is no backing track: the song starts when you grab the first branch and every grab restarts the beat.

No MIDI? Keys [b]A S D F G H J K[/b] = C4 D4 E4 F4 G4 A4 B4 C5.

[b]Click or press Space to start[/b][/center]"
fit_content = true
scroll_active = false
